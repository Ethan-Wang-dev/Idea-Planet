{
  "manifest_version": 3,
  "name": "Idea Planet · Send to your orbit",
  "version": "0.1.1",
  "description": "保存 X 上的内容，回来决定它是否值得成为你的 Idea。",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "http://localhost:4317/*"],
  "action": { "default_title": "送入 Idea Planet", "default_popup": "popup.html" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["http://localhost:4317/*"], "js": ["bridge.js"], "run_at": "document_idle" }
  ]
}
